# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave DATABASE_URL unset and the storefront runs from data/catalog.json —
# the full 118-product catalog, browsable with no database at all.
# Set it and the site reads MySQL instead, and carts persist server-side.
#
#   DATABASE_URL="mysql://user:password@127.0.0.1:3306/glasshousequartz"
#
# Then:  npm run db:setup    (creates tables and loads the catalog)
DATABASE_URL=

# Connections held in the pool.
DATABASE_POOL_SIZE=10

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.glasshousequartz.com

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# Unset means checkout is disabled and says so, rather than pretending to work.
# Implement a provider in src/lib/payments.ts before setting this.
#   PAYMENT_PROVIDER=stripe
#   STRIPE_SECRET_KEY=sk_live_...
#   STRIPE_WEBHOOK_SECRET=whsec_...
PAYMENT_PROVIDER=
